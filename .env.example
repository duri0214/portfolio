# Apache access report: configure SMTP and the fixed report mailbox in lib/mail/.env.
# The log glob has a default and includes rotated .gz logs.
# Set this only when Apache logs are stored elsewhere or multiple locations are needed.
# APACHE_ACCESS_LOG_GLOBS=/var/log/apache2/access.log*
# Set this in production so ubuntu and www-data share the generated report.
# APACHE_ACCESS_REPORT_PATH=/var/lib/portfolio/apache_access_report.json
# If omitted, local runs use .private/apache_access_report.json.
